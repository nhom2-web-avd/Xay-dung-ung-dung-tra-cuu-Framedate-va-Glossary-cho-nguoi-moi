  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run build:nestjs && nodemon server.js",
    "dev:client": "vite",
    "build": "tsc -p tsconfig.server.json && vite build",
    "build:nestjs": "tsc -p tsconfig.server.json",
    "start": "node server.js",
    "start:server": "node server.js",
    "start:nestjs": "node dist-server/main.js",
    "dev:nestjs": "concurrently \"npm run build:nestjs && npm run start:nestjs\" \"npm run dev:client\"",
    "preview": "vite preview",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f mysql",
    "db:migrate": "node database/migrate.js",
    "db:setup": "node database/setup.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
